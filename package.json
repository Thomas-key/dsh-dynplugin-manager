{
  "name": "dsh-dynplugin-manager",
  "version": "0.2.0",
  "description": "Manage DSH dynamic plugins (Dynamic Cordis Plugins): scan directories, browse, load self-contained plugins via /dynload (runner channel), and mount community npm plugins via /dynmount (loader channel, insert row + official patch watcher, persistent).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "dynamic-plugin",
    "dynplugin"
  ],
  "license": "MIT",
  "author": "illusion",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
